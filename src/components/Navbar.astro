---
import { getCollection } from 'astro:content'

const allDocs = await getCollection('docs')
const allPages = allDocs.map(doc => ({
    title: doc.data.title,
    description: doc.data.description ?? '',
    href: `/docs/${doc.id}`,
}))

const isDocsActive = Astro.url.pathname.startsWith('/docs')
---

<header id="navbar" class="fixed top-0 left-0 right-0 h-14 z-50 flex items-center px-4 border-b border-(--color-border) backdrop-blur-2xl">

    <a href="/" class="flex items-center shrink-0 no-underline sm:w-[260px]">
        <i class="fa-solid fa-ship text-sm text-(--color-primary) mr-2"></i>
        <span class="text-sm tracking-tight text-(--color-text-primary)">vessel</span>
        <span class="text-[11px] font-medium tracking-widest uppercase text-(--color-text-muted) ml-1" style="font-family: var(--font-mono);">wiki</span>
    </a>

    <div id="search-trigger" class="hidden md:flex items-center gap-2 flex-1 mx-4 ml-auto px-3 py-1.5 rounded-lg border border-(--color-border) cursor-pointer transition-colors duration-150 hover:border-white/15 max-w-sm bg-(--color-card)">
        <i class="fa-solid fa-magnifying-glass text-xs text-(--color-text-muted)"></i>
        <span class="flex-1 text-xs text-(--color-text-muted)">Search docs...</span>
        <span class="text-[10px] px-1.5 py-0.5 rounded border border-(--color-border) text-(--color-text-muted)">⌘K</span>
    </div>

    <div class="hidden md:flex items-center gap-1 ml-auto shrink-0">
        <a href="/docs" rel="noopener noreferrer"
           class=`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs text-(--color-text-muted) no-underline transition-colors duration-150 hover:text-(--color-text-primary) hover:bg-white/3 ${isDocsActive ? "bg-white/3" : ""}`>
            <i class="fa-solid fa-book text-[10px]"></i>
            <span>Docs</span>
        </a>
        <a href="https://discord.vessel.wiki" target="_blank" rel="noopener noreferrer"
           class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs text-(--color-text-muted) no-underline transition-colors duration-150 hover:text-(--color-text-primary) hover:bg-white/3">
            <i class="fa-brands fa-discord text-[10px]"></i>
            <span>Discord</span>
        </a>
        <a href="https://github.com/vessel-db" target="_blank" rel="noopener noreferrer"
           class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs text-(--color-text-muted) no-underline transition-colors duration-150 hover:text-(--color-text-primary) hover:bg-white/3">
            <i class="fa-brands fa-github text-[10px]"></i>
            <span>GitHub</span>
        </a>
    </div>

    <div class="flex md:hidden items-center ml-auto">
        <button id="mobile-menu-btn" class="flex items-center justify-center w-8 h-8 rounded-lg text-(--color-text-muted) transition-colors duration-150 hover:text-(--color-text-primary) hover:bg-white/5" aria-label="Menu">
            <i id="mobile-menu-icon" class="fa-solid fa-bars text-xs"></i>
        </button>
    </div>
</header>

<div id="mobile-menu" class="fixed top-14 left-0 right-0 z-40 md:hidden border-b border-(--color-border) backdrop-blur-2xl overflow-hidden" style="max-height: 0; transition: max-height 0.2s ease, opacity 0.2s ease; opacity: 0">
    <div class="px-3 py-2 flex flex-col gap-0.5">
        <button id="mobile-search-btn" class="flex items-center gap-3 w-full px-3 py-2.5 rounded-lg text-sm text-(--color-text-muted) transition-colors duration-150 hover:text-(--color-text-primary) hover:bg-white/5 text-left">
            <i class="fa-solid fa-magnifying-glass text-xs w-4 text-center"></i>
            <span>Search docs...</span>
            <span class="ml-auto text-[10px] px-1.5 py-0.5 rounded border border-(--color-border) text-(--color-text-muted)">⌘K</span>
        </button>
        <a href="/docs" class=`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-(--color-text-muted) no-underline transition-colors duration-150 hover:text-(--color-text-primary) hover:bg-white/5 ${isDocsActive ? "bg-white/5" : ""}`>
            <i class="fa-solid fa-book text-xs w-4 text-center"></i>
            <span>Docs</span>
        </a>
        <a href="https://discord.vessel.wiki" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-(--color-text-muted) no-underline transition-colors duration-150 hover:text-(--color-text-primary) hover:bg-white/5">
            <i class="fa-brands fa-discord text-xs w-4 text-center"></i>
            <span>Discord</span>
        </a>
        <a href="https://github.com/vessel-db" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-(--color-text-muted) no-underline transition-colors duration-150 hover:text-(--color-text-primary) hover:bg-white/5">
            <i class="fa-brands fa-github text-xs w-4 text-center"></i>
            <span>GitHub</span>
        </a>
    </div>
</div>

<div id="search-modal" class="fixed inset-0 z-200 flex items-start justify-center pt-[15vh] px-4 opacity-0 pointer-events-none transition-opacity duration-150" style="background: rgba(9,21,37,0.75); backdrop-filter: blur(6px);">
    <div id="search-box" class="w-full max-w-lg rounded-xl border border-(--color-border) overflow-hidden translate-y-2 transition-transform duration-150" style="background: var(--color-surface);">
        <div class="flex items-center gap-3 px-4 py-3 border-b border-(--color-border)">
            <i class="fa-solid fa-magnifying-glass text-xs text-(--color-text-muted)"></i>
            <input
                    id="search-input"
                    type="text"
                    placeholder="Search docs..."
                    class="flex-1 bg-transparent border-none outline-none text-sm text-(--color-text-primary)"
                    autocomplete="off"
            />
            <kbd class="hidden sm:flex text-[10px] px-1.5 py-0.5 rounded border border-(--color-border) text-(--color-text-muted)">Esc</kbd>
        </div>
        <ul id="search-results" class="list-none p-0 m-0 max-h-72 overflow-y-auto"></ul>
        <div id="search-empty" class="px-4 py-8 text-center text-sm hidden text-(--color-text-muted)">No results found</div>
    </div>
</div>

<script define:vars={{ allPages }}>
    const modal = document.getElementById('search-modal')
    const box = document.getElementById('search-box')
    const input = document.getElementById('search-input')
    const results = document.getElementById('search-results')
    const empty = document.getElementById('search-empty')
    const mobileMenu = document.getElementById('mobile-menu')
    const mobileMenuBtn = document.getElementById('mobile-menu-btn')
    const mobileMenuIcon = document.getElementById('mobile-menu-icon')
    let menuOpen = false

    function openSearch() {
        closeMenu()
        modal.classList.remove('opacity-0', 'pointer-events-none')
        box.classList.remove('translate-y-2')
        input.focus()
        render('')
    }

    function closeSearch() {
        modal.classList.add('opacity-0', 'pointer-events-none')
        box.classList.add('translate-y-2')
        input.value = ''
    }

    function toggleMenu() {
        menuOpen = !menuOpen
        if (menuOpen) {
            mobileMenu.style.maxHeight = mobileMenu.scrollHeight + 'px'
            mobileMenu.style.opacity = '1'
            mobileMenuIcon.className = 'fa-solid fa-xmark text-xs'
        } else {
            closeMenu()
        }
    }

    function closeMenu() {
        menuOpen = false
        mobileMenu.style.maxHeight = '0'
        mobileMenu.style.opacity = '0'
        mobileMenuIcon.className = 'fa-solid fa-bars text-xs'
    }

    function render(query) {
        const q = query.toLowerCase().trim()
        const pages = window.__vesselPages__ || allPages
        const filtered = q ? pages.filter(p => p.title.toLowerCase().includes(q) || p.description.toLowerCase().includes(q)) : pages
        results.innerHTML = ''
        empty.classList.toggle('hidden', filtered.length > 0)
        filtered.forEach(page => {
            const li = document.createElement('li')
            li.innerHTML = `
                <a href="${page.href}" class="search-result flex items-center gap-3 px-4 py-3 border-b border-white/[0.04] transition-colors duration-100 no-underline">
                    <i class="fa-solid fa-file-lines text-xs w-3.5 text-center" style="color: var(--color-text-muted);"></i>
                    <div class="min-w-0">
                        <p class="text-sm font-medium m-0 text-(--color-text-primary)">${page.title}</p>
                        ${page.description ? `<p class="text-xs m-0 mt-0.5 truncate text-(--color-text-muted)">${page.description}</p>` : ''}
                    </div>
                </a>`
            results.appendChild(li)
        })
    }

    document.getElementById('search-trigger').addEventListener('click', openSearch)
    document.getElementById('mobile-search-btn').addEventListener('click', openSearch)
    mobileMenuBtn.addEventListener('click', toggleMenu)
    input.addEventListener('input', e => render(e.target.value))
    modal.addEventListener('click', e => { if (!box.contains(e.target)) closeSearch() })
    document.addEventListener('keydown', e => {
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); openSearch() }
        if (e.key === 'Escape') { closeSearch(); closeMenu() }
    })
    results.addEventListener('mouseover', e => { const a = e.target.closest('.search-result'); if (a) a.style.background = 'rgba(130,159,189,0.05)' })
    results.addEventListener('mouseout', e => { const a = e.target.closest('.search-result'); if (a) a.style.background = '' })
</script>

<style>
    #search-input::placeholder { color: var(--color-text-muted); }
</style>